+/* JUCE's swapchain-based editor renderer is opaque. Limit the compatibility
+ * exception to Nexus's own JUCE window class; a non-layered HWND alone does not
+ * prove that arbitrary DirectComposition content is opaque. */
+static BOOL composition_gpu_allowed(struct composition_target *target, struct composition_visual *visual)
+{
+    WCHAR name[64], module[MAX_PATH], *basename;
+    IDXGISwapChain1 *content;
+    DXGI_SWAP_CHAIN_DESC1 desc;
+    char option[2] = {0};
+    BOOL nexus = FALSE;
+    DWORD length;
+
+    length = GetEnvironmentVariableA("WINE_DCOMP_GPU", option, sizeof(option));
+    if (length && option[0] == '0') return FALSE;
+    if (GetClassNameW(target->hwnd, name, ARRAY_SIZE(name)) && !wcsncmp(name, L"JUCE_", 5))
+    {
+        length = GetModuleFileNameW((HMODULE)GetClassLongPtrW(target->hwnd, GCLP_HMODULE), module,
+                                   ARRAY_SIZE(module));
+        if (length && length < ARRAY_SIZE(module))
+        {
+            basename = wcsrchr(module, '\\');
+            basename = basename ? basename + 1 : module;
+            nexus = !wcsicmp(basename, L"Nexus.vst3") || !wcsicmp(basename, L"Nexus.dll");
+        }
+    }
+    if (nexus) return TRUE;
+    /* Explicit opt-in can enable other API-declared opaque content, but never
+     * silently discard alpha from arbitrary premultiplied composition content. */
+    if (option[0] != '1' || !IsEqualGUID(&visual->content_iid, &IID_IDXGISwapChain1)) return FALSE;
+    if (FAILED(IUnknown_QueryInterface(visual->content, &IID_IDXGISwapChain1, (void **)&content))) return FALSE;
+    length = SUCCEEDED(IDXGISwapChain1_GetDesc1(content, &desc)) && desc.AlphaMode == DXGI_ALPHA_MODE_IGNORE;
+    IDXGISwapChain1_Release(content);
+    return length;
+}
+
+static HRESULT composite_gpu(struct composition_target *target, struct composition_visual *visual,
+        IDXGISurface *surface, UINT64 serial)
+{
+    DXGI_SWAP_CHAIN_DESC1 sc_desc = {0};
+    DXGI_SURFACE_DESC desc;
+    ID3D11Device *device = NULL;
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Resource *source = NULL;
+    ID3D11Texture2D *destination = NULL;
+    IDXGIDevice *dxgi_device = NULL;
+    IDXGIAdapter *adapter = NULL;
+    IDXGIFactory2 *factory = NULL;
+    RECT client;
+    HRESULT hr = S_FALSE;
+
+    if (!composition_gpu_allowed(target, visual)
+            || !target->root || impl_from_IDCompositionVisual(target->root) != visual
+            || !list_empty(&visual->child_visuals) || visual->shared_visual_handle || visual->offset_x
+            || (GetWindowLongW(target->hwnd, GWL_EXSTYLE) & WS_EX_LAYERED)
+            || GetWindow(target->hwnd, GW_CHILD)
+            || GetPropW(target->hwnd, target->topmost ? L"wine_window_non_topmost_composed"
+                                                    : L"wine_window_topmost_composed"))
+        goto done;
+    if (!IsWindowVisible(target->hwnd))
+    {
+        /* Force the first visible tick to submit again even if no new frame
+         * was produced while hidden. */
+        target->gpu_valid = FALSE;
+        return target->gpu_swapchain ? S_OK : S_FALSE;
+    }
+    if (FAILED(IDXGISurface_GetDesc(surface, &desc)) || !GetClientRect(target->hwnd, &client)
+            || desc.Width != client.right || desc.Height != client.bottom)
+        goto done;
+    if (target->gpu_swapchain && (target->gpu_visual != visual || target->gpu_content != visual->content
+            || target->gpu_width != desc.Width || target->gpu_height != desc.Height
+            || target->gpu_format != desc.Format))
+        composition_target_clear_gpu(target);
+    if (target->gpu_valid && target->gpu_serial == serial) return S_OK;
+
+    if (FAILED(hr = IDXGISurface_GetDevice(surface, &IID_ID3D11Device, (void **)&device))) goto done;
+    if (!target->gpu_swapchain)
+    {
+        if (FAILED(hr = ID3D11Device_QueryInterface(device, &IID_IDXGIDevice, (void **)&dxgi_device))) goto done;
+        if (FAILED(hr = IDXGIDevice_GetAdapter(dxgi_device, &adapter))) goto done;
+        if (FAILED(hr = IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&factory))) goto done;
+        sc_desc.Width = desc.Width; sc_desc.Height = desc.Height; sc_desc.Format = desc.Format;
+        sc_desc.SampleDesc.Count = 1;
+        sc_desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+        sc_desc.BufferCount = 2;
+        sc_desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+        sc_desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+        if (FAILED(hr = IDXGIFactory2_CreateSwapChainForHwnd(factory, (IUnknown *)device, target->hwnd,
+                &sc_desc, NULL, NULL, &target->gpu_swapchain))) goto done;
+        target->gpu_visual = visual;
+        target->gpu_content = visual->content;
+        IUnknown_AddRef(target->gpu_content);
+        visual->gpu_target = target;
+        target->gpu_width = desc.Width; target->gpu_height = desc.Height; target->gpu_format = desc.Format;
+        TRACE("GPU composition target created %p %ux%u.\n", target->hwnd, desc.Width, desc.Height);
+    }
+    if (FAILED(hr = IDXGISurface_QueryInterface(surface, &IID_ID3D11Resource, (void **)&source))) goto done;
+    if (FAILED(hr = IDXGISwapChain1_GetBuffer(target->gpu_swapchain, 0, &IID_ID3D11Texture2D,
+            (void **)&destination))) goto done;
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)destination, source);
+    /* CopyResource leaves pipeline state alone. Do not hold a context lock over
+     * Present, which must acquire its own swapchain buffer lock first. */
+    hr = IDXGISwapChain1_Present(target->gpu_swapchain, 0, 0);
+    if (hr == S_OK)
+    {
+        target->gpu_valid = TRUE;
+        target->gpu_serial = serial;
+        TRACE("GPU composition presented serial %s.\n", wine_dbgstr_longlong(serial));
+    }
+done:
+    if (destination) ID3D11Texture2D_Release(destination);
+    if (source) ID3D11Resource_Release(source);
+    if (context) ID3D11DeviceContext_Release(context);
+    if (device) ID3D11Device_Release(device);
+    if (factory) IDXGIFactory2_Release(factory);
+    if (adapter) IDXGIAdapter_Release(adapter);
+    if (dxgi_device) IDXGIDevice_Release(dxgi_device);
+    if (hr != S_OK) composition_target_clear_gpu(target);
+    return hr;
+}
