+struct d2d_bounded_segment
+{
+    struct d2d_segment_idx idx;
+    D2D1_RECT_F bounds;
+    BOOL bezier;
+};
+
+static int __cdecl d2d_bounded_segment_compare(const void *a, const void *b)
+{
+    const struct d2d_bounded_segment *p = a, *q = b;
+
+    if (p->bounds.left != q->bounds.left)
+        return p->bounds.left < q->bounds.left ? -1 : 1;
+    if (p->idx.figure_idx != q->idx.figure_idx)
+        return p->idx.figure_idx < q->idx.figure_idx ? -1 : 1;
+    return p->idx.vertex_idx < q->idx.vertex_idx ? -1 : p->idx.vertex_idx != q->idx.vertex_idx;
+}
+
+struct d2d_segment_pair
+{
+    const struct d2d_bounded_segment *p, *q;
+};
+
+static int __cdecl d2d_segment_pair_compare(const void *a, const void *b)
+{
+    const struct d2d_segment_pair *p = a, *q = b;
+
+    if (p->p->idx.figure_idx != q->p->idx.figure_idx)
+        return p->p->idx.figure_idx < q->p->idx.figure_idx ? -1 : 1;
+    if (p->p->idx.vertex_idx != q->p->idx.vertex_idx)
+        return p->p->idx.vertex_idx < q->p->idx.vertex_idx ? -1 : 1;
+    if (p->q->idx.figure_idx != q->q->idx.figure_idx)
+        return p->q->idx.figure_idx < q->q->idx.figure_idx ? -1 : 1;
+    return p->q->idx.vertex_idx < q->q->idx.vertex_idx ? -1 : p->q->idx.vertex_idx != q->q->idx.vertex_idx;
+}
+
+/* Sort conservative segment bounds along x, then only test overlapping pairs.
+ * Restore original pair order before testing, including ties between rounded
+ * intersection parameters. Dense paths retain the bounded-memory old method. */
+static BOOL d2d_geometry_intersect_self(struct d2d_geometry *geometry)
+{
+    struct d2d_geometry_intersections intersections = {0};
+    struct d2d_bounded_segment *segments, *s;
+    struct d2d_segment_pair *pairs;
+    size_t pair_count = 0, max_pairs;
+    const struct d2d_bounded_segment *p, *q, *tmp;
+    const struct d2d_figure *figure;
+    const D2D1_POINT_2F *points[3];
+    size_t count = 0, capacity = 0, i, j, k, c, n;
+    BOOL ret = FALSE;
+
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+    {
+        if (geometry->u.path.figures[i].vertex_count > SIZE_MAX - capacity)
+            return d2d_geometry_intersect_self_brute_force(geometry);
+        capacity += geometry->u.path.figures[i].vertex_count;
+    }
+    if (capacity < 32 || capacity > SIZE_MAX / sizeof(*segments)
+            || !(segments = malloc(capacity * sizeof(*segments))))
+        return d2d_geometry_intersect_self_brute_force(geometry);
+
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        for (j = 0, c = 0; j < figure->vertex_count; ++j)
+        {
+            if (figure->vertex_types[j] == D2D_VERTEX_TYPE_END)
+                continue;
+            s = &segments[count++];
+            s->idx.figure_idx = i;
+            s->idx.vertex_idx = j;
+            s->idx.control_idx = c;
+            s->bezier = d2d_vertex_type_is_bezier(figure->vertex_types[j]);
+            points[0] = &figure->vertices[j];
+            points[1] = &figure->vertices[j + 1 == figure->vertex_count ? 0 : j + 1];
+            n = 2;
+            if (s->bezier)
+                points[n++] = &figure->bezier_controls[c++];
+            s->bounds.left = s->bounds.right = points[0]->x;
+            s->bounds.top = s->bounds.bottom = points[0]->y;
+            for (k = 0; k < n; ++k)
+            {
+                if (!isfinite(points[k]->x) || !isfinite(points[k]->y))
+                {
+                    free(segments);
+                    return d2d_geometry_intersect_self_brute_force(geometry);
+                }
+                s->bounds.left = min(s->bounds.left, points[k]->x);
+                s->bounds.right = max(s->bounds.right, points[k]->x);
+                s->bounds.top = min(s->bounds.top, points[k]->y);
+                s->bounds.bottom = max(s->bounds.bottom, points[k]->y);
+            }
+        }
+    }
+
+    max_pairs = count > 65536 ? 1048576 : count * 16;
+    if (!(pairs = malloc(max_pairs * sizeof(*pairs))))
+    {
+        free(segments);
+        return d2d_geometry_intersect_self_brute_force(geometry);
+    }
+    qsort(segments, count, sizeof(*segments), d2d_bounded_segment_compare);
+    for (i = 0; i < count; ++i)
+    {
+        for (j = i + 1; j < count && segments[j].bounds.left <= segments[i].bounds.right; ++j)
+        {
+            p = &segments[i];
+            q = &segments[j];
+            if (p->bounds.top > q->bounds.bottom || p->bounds.bottom < q->bounds.top)
+                continue;
+            if (p->idx.figure_idx != q->idx.figure_idx
+                    && !d2d_rect_check_overlap(&geometry->u.path.figures[p->idx.figure_idx].bounds,
+                            &geometry->u.path.figures[q->idx.figure_idx].bounds))
+                continue;
+            if (p->idx.figure_idx < q->idx.figure_idx
+                    || (p->idx.figure_idx == q->idx.figure_idx && p->idx.vertex_idx < q->idx.vertex_idx))
+            {
+                tmp = p;
+                p = q;
+                q = tmp;
+            }
+            if (pair_count == max_pairs)
+            {
+                free(pairs);
+                free(segments);
+                return d2d_geometry_intersect_self_brute_force(geometry);
+            }
+            pairs[pair_count].p = p;
+            pairs[pair_count++].q = q;
+        }
+    }
+    qsort(pairs, pair_count, sizeof(*pairs), d2d_segment_pair_compare);
+    for (i = 0; i < pair_count; ++i)
+    {
+        p = pairs[i].p;
+        q = pairs[i].q;
+        if (p->bezier && q->bezier)
+            ret = d2d_geometry_intersect_bezier_bezier(geometry, &intersections,
+                    &p->idx, 0.0f, 1.0f, &q->idx, 0.0f, 1.0f);
+        else if (p->bezier || q->bezier)
+            ret = d2d_geometry_intersect_bezier_line(geometry, &intersections,
+                    p->bezier ? &p->idx : &q->idx, p->bezier ? &q->idx : &p->idx);
+        else
+            ret = d2d_geometry_intersect_line_line(geometry, &intersections, &p->idx, &q->idx);
+        if (!ret)
+            goto done;
+    }
+    qsort(intersections.intersections, intersections.intersection_count,
+            sizeof(*intersections.intersections), d2d_geometry_intersections_compare);
+    ret = d2d_geometry_apply_intersections(geometry, &intersections);
+
+done:
+    free(intersections.intersections);
+    free(pairs);
+    free(segments);
+    return ret;
+}
