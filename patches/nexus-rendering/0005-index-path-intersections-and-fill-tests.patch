+#define D2D_FILL_BUCKET_COUNT 64
+struct d2d_fill_edge
+{
+    const struct d2d_figure *figure;
+    const D2D1_POINT_2F *p0, *p1;
+};
+struct d2d_fill_index
+{
+    struct d2d_fill_edge *edges;
+    size_t *entries;
+    size_t offsets[D2D_FILL_BUCKET_COUNT + 1];
+    double top, height;
+};
+
+static unsigned int d2d_fill_bucket(const struct d2d_fill_index *index, float y)
+{
+    double bucket = ((double)y - index->top) / index->height * D2D_FILL_BUCKET_COUNT;
+    return bucket <= 0.0 ? 0 : bucket >= D2D_FILL_BUCKET_COUNT - 1
+            ? D2D_FILL_BUCKET_COUNT - 1 : (unsigned int)bucket;
+}
+
+/* Only used for triangle classification, after all path edits are complete. */
+static void d2d_fill_index_init(struct d2d_fill_index *index, const struct d2d_geometry *geometry)
+{
+    size_t count = 0, n = 0, total = 0, i, j, positions[D2D_FILL_BUCKET_COUNT];
+    unsigned int first, last, bucket;
+    const struct d2d_figure *figure;
+    struct d2d_fill_edge *edge;
+    double bottom = -DBL_MAX;
+
+    index->top = DBL_MAX;
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        if (figure->vertex_count > SIZE_MAX - count)
+            return;
+        count += figure->vertex_count;
+        for (j = 0; j < figure->vertex_count; ++j)
+        {
+            if (!isfinite(figure->vertices[j].x) || !isfinite(figure->vertices[j].y))
+                return;
+            index->top = min(index->top, figure->vertices[j].y);
+            bottom = max(bottom, figure->vertices[j].y);
+        }
+    }
+    index->height = bottom - index->top;
+    if (count < 64 || index->height <= 0.0 || !isfinite(index->height)
+            || count > SIZE_MAX / sizeof(*index->edges)
+            || !(index->edges = malloc(count * sizeof(*index->edges))))
+        return;
+
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        for (j = 0; j < figure->vertex_count; ++j)
+        {
+            edge = &index->edges[n++];
+            edge->figure = figure;
+            edge->p0 = &figure->vertices[j ? j - 1 : figure->vertex_count - 1];
+            edge->p1 = &figure->vertices[j];
+            first = d2d_fill_bucket(index, min(edge->p0->y, edge->p1->y));
+            last = d2d_fill_bucket(index, max(edge->p0->y, edge->p1->y));
+            /* Bound temporary storage; dense paths use the original scan. */
+            if (total > 1048576 - (last - first + 1))
+                goto fail;
+            total += last - first + 1;
+            for (bucket = first; bucket <= last; ++bucket)
+                ++index->offsets[bucket + 1];
+        }
+    }
+    if (!(index->entries = malloc(total * sizeof(*index->entries))))
+        goto fail;
+    for (bucket = 0; bucket < D2D_FILL_BUCKET_COUNT; ++bucket)
+    {
+        index->offsets[bucket + 1] += index->offsets[bucket];
+        positions[bucket] = index->offsets[bucket];
+    }
+    for (i = 0; i < n; ++i)
+    {
+        edge = &index->edges[i];
+        first = d2d_fill_bucket(index, min(edge->p0->y, edge->p1->y));
+        last = d2d_fill_bucket(index, max(edge->p0->y, edge->p1->y));
+        for (bucket = first; bucket <= last; ++bucket)
+            index->entries[positions[bucket]++] = i;
+    }
+    return;
+
+fail:
+    free(index->edges);
+    index->edges = NULL;
+}
+
+static BOOL d2d_fill_index_contains(const struct d2d_fill_index *index,
+        const struct d2d_geometry *geometry, const D2D1_POINT_2F *probe)
+{
+    unsigned int bucket, score = 0;
+    const struct d2d_fill_edge *edge;
+    D2D1_POINT_2F v_p, v_probe;
+    const D2D1_RECT_F *bounds;
+    size_t i;
+
+    if (!index->entries || !isfinite(probe->y))
+        return d2d_path_geometry_point_inside(geometry, probe, TRUE);
+    bucket = d2d_fill_bucket(index, probe->y);
+    for (i = index->offsets[bucket]; i < index->offsets[bucket + 1]; ++i)
+    {
+        edge = &index->edges[index->entries[i]];
+        bounds = &edge->figure->bounds;
+        if (probe->x < bounds->left || probe->x > bounds->right
+                || probe->y < bounds->top || probe->y > bounds->bottom)
+            continue;
+        if ((probe->y < edge->p0->y) == (probe->y < edge->p1->y))
+            continue;
+        d2d_point_subtract(&v_p, edge->p1, edge->p0);
+        d2d_point_subtract(&v_probe, probe, edge->p0);
+        if (v_probe.x < v_p.x * (v_probe.y / v_p.y))
+        {
+            if (geometry->u.path.fill_mode == D2D1_FILL_MODE_ALTERNATE || probe->y < edge->p0->y)
+                ++score;
+            else
+                --score;
+        }
+    }
+    return geometry->u.path.fill_mode == D2D1_FILL_MODE_ALTERNATE ? score & 1 : score;
+}
