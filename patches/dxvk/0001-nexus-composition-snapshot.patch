+  HRESULT STDMETHODCALLTYPE D3D11SwapChain::GetCompositionSnapshot(
+          IDXGISurface** surface, UINT64* serial) {
+    if (!surface || !serial)
+      return E_POINTER;
+    *surface = nullptr;
+    *serial = 0;
+
+    if (m_desc.SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL
+     || m_backBuffers.size() < 2 || m_desc.SampleDesc.Count != 1
+     || (m_desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM
+      && m_desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM))
+      return DXGI_ERROR_UNSUPPORTED;
+    if (m_device->getDeviceStatus() != VK_SUCCESS)
+      return DXGI_ERROR_DEVICE_RESET;
+
+    // Protection must be forced at device creation, before any rendering can
+    // overlap composition. Enabling it here cannot synchronize calls which
+    // already entered the context without a lock.
+    if (!m_parent->GetOptions()->enableContextLock)
+      return DXGI_ERROR_UNSUPPORTED;
+
+    // The caller holds the DXGI buffer lock. Never acquire that lock while
+    // holding this context lock.
+    auto context = m_parent->GetContext();
+    auto lock = context->LockContext();
+    if (!m_hasPresentedFrame)
+      return S_FALSE;
+
+    try {
+      D3D11_TEXTURE2D_DESC desc = {};
+      desc.Width = m_desc.Width;
+      desc.Height = m_desc.Height;
+      desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+      desc.Format = m_desc.Format;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+      Com<ID3D11Texture2D> texture;
+      HRESULT hr = m_parent->CreateTexture2D(&desc, nullptr, &texture);
+      if (FAILED(hr))
+        return hr;
+
+      Rc<DxvkImage> source = m_compositionBuffer ? m_compositionBuffer
+        : GetCommonTexture(m_backBuffers.back().ptr())->GetImage();
+      Rc<DxvkImage> destination = GetCommonTexture(texture.ptr())->GetImage();
+      context->EmitCs([source, destination] (DxvkContext* ctx) {
+        VkImageSubresourceLayers subresource = {};
+        subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        subresource.layerCount = 1;
+        ctx->copyImage(destination, subresource, VkOffset3D(),
+          source, subresource, VkOffset3D(), source->info().extent);
+      });
+      context->FlushCsChunk();
+      hr = texture->QueryInterface(__uuidof(IDXGISurface), reinterpret_cast<void**>(surface));
+      if (SUCCEEDED(hr))
+        *serial = m_frameId;
+      return hr;
+    } catch (const DxvkError& error) {
+      Logger::err(error.message());
+      return E_FAIL;
+    } catch (const std::bad_alloc&) {
+      return E_OUTOFMEMORY;
+    }
+  }
+
