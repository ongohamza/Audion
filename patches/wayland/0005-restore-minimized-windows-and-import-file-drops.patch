@@ -665,24 +962,80 @@ static void data_device_enter(void *data, struct wl_data_device *wl_data_device,
                               wl_fixed_t x_w, wl_fixed_t y_w,
                               struct wl_data_offer *wl_data_offer)
 {
+    BOOL busy;
+
+    if (drag_offer) wayland_data_offer_destroy(drag_offer);
+    drag_offer = wl_data_offer ? wl_data_offer_get_user_data(wl_data_offer) : NULL;
+    drag_hwnd = wl_surface ? wl_surface_get_user_data(wl_surface) : 0;
+    drag_serial = serial;
+    pthread_mutex_lock(&drop_mutex);
+    busy = !!pending_drop.offer || drop_gui_busy;
+    pthread_mutex_unlock(&drop_mutex);
+    if (drag_offer && !busy && drag_hwnd && drag_update_point(x_w, y_w) &&
+        string_array_contains(&drag_offer->types, "text/uri-list"))
+    {
+        if (wl_data_offer_get_version(wl_data_offer) >= 3)
+            wl_data_offer_set_actions(wl_data_offer, WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY,
+                                      WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);
+        wl_data_offer_accept(wl_data_offer, serial, "text/uri-list");
+    }
+    else
+    {
+        drag_hwnd = 0;
+        if (wl_data_offer) wl_data_offer_accept(wl_data_offer, serial, NULL);
+    }
+    wl_display_flush(process_wayland.wl_display);
 }
 
 static void data_device_leave(void *data, struct wl_data_device *wl_data_device)
 {
+    if (drag_offer) wayland_data_offer_destroy(drag_offer);
+    drag_offer = NULL;
+    drag_hwnd = 0;
 }
 
 static void data_device_motion(void *data, struct wl_data_device *wl_data_device,
                                uint32_t time, wl_fixed_t x_w, wl_fixed_t y_w)
 {
+    if (drag_hwnd && !drag_update_point(x_w, y_w))
+    {
+        drag_hwnd = 0;
+        if (drag_offer) wl_data_offer_accept(drag_offer->wl_data_offer, drag_serial, NULL);
+    }
 }
 
 static void data_device_drop(void *data, struct wl_data_device *wl_data_device)
 {
+    int fd;
+
+    pthread_mutex_lock(&drop_mutex);
+    if (drag_offer && drag_hwnd && !pending_drop.offer && !drop_gui_busy &&
+        drag_offer->dnd_action == WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY &&
+        (fd = wayland_data_offer_get_import_fd(drag_offer, "text/uri-list")) >= 0)
+    {
+        pending_drop.offer = drag_offer;
+        pending_drop.fd = fd;
+        pending_drop.hwnd = drag_hwnd;
+        pending_drop.point = drag_point;
+        pending_drop.generation = ++drop_generation;
+        drag_offer = NULL;
+        pthread_cond_signal(&drop_cond);
+    }
+    pthread_mutex_unlock(&drop_mutex);
+    if (drag_offer) wayland_data_offer_destroy(drag_offer);
+    drag_offer = NULL;
+    drag_hwnd = 0;
 }
 
