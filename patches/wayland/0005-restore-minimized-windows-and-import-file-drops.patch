+/* Only local file URIs are imported. In particular, a file manager's remote
+ * URLs must never cause a network fetch or be interpreted as local paths. */
+static int uri_hex(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static char *local_uri_path(const char *uri, size_t size)
+{
+    const char *path, *end = uri + size;
+    char hostname[256], *out, *p;
+    int hi, lo;
+
+    if (size < 6 || memcmp(uri, "file:/", 6) || memchr(uri, 0, size)) return NULL;
+    path = uri + 5;
+    if (size >= 7 && uri[6] == '/')
+    {
+        const char *host = uri + 7;
+        if (!(path = memchr(host, '/', end - host))) return NULL;
+        if (path != host && !(path - host == 9 && !memcmp(host, "localhost", 9)))
+        {
+            if (gethostname(hostname, sizeof(hostname))) return NULL;
+            hostname[sizeof(hostname) - 1] = 0;
+            if (strlen(hostname) != (size_t)(path - host) || memcmp(host, hostname, path - host)) return NULL;
+        }
+    }
+    if (!(out = malloc(end - path + 1))) return NULL;
+    for (p = out; path < end; ++path)
+    {
+        if (*path == '?' || *path == '#') goto invalid;
+        if (*path == '%')
+        {
+            if (end - path < 3 || (hi = uri_hex(path[1])) < 0 ||
+                (lo = uri_hex(path[2])) < 0 || !(hi || lo)) goto invalid;
+            *p++ = (hi << 4) | lo;
+            path += 2;
+        }
+        else *p++ = *path;
+    }
+    *p = 0;
+    return out;
+invalid:
+    free(out);
+    return NULL;
+}
+
+static void *import_uri_list(void *data, size_t size, size_t *ret_size)
+{
+    const char *line = data, *end = line + size, *next;
+    struct drop_files *drop = NULL, *new_drop;
+    size_t used = sizeof(*drop), len;
+    WCHAR *dos;
+    char *path;
+
+    while (line < end)
+    {
+        next = memchr(line, '\n', end - line);
+        if (!next) next = end;
+        len = next - line;
+        if (len && line[len - 1] == '\r') --len;
+        if (len && *line != '#' && (path = local_uri_path(line, len)))
+        {
+            dos = NULL;
+            ntdll_get_dos_file_name(path, &dos, FILE_OPEN);
+            free(path);
+            if (dos)
+            {
+                len = (lstrlenW(dos) + 1) * sizeof(WCHAR);
+                new_drop = realloc(drop, used + len + sizeof(WCHAR));
+                if (!new_drop) { free(dos); free(drop); return NULL; }
+                drop = new_drop;
+                memcpy((char *)drop + used, dos, len);
+                used += len;
+                free(dos);
+            }
+        }
+        line = next == end ? end : next + 1;
+    }
+    if (!drop) return NULL;
+    memset(drop, 0, sizeof(*drop));
+    drop->pFiles = sizeof(*drop);
+    drop->fWide = TRUE;
+    *(WCHAR *)((char *)drop + used) = 0;
+    *ret_size = used + sizeof(WCHAR);
+    return drop;
+}
+
+#define DROP_MAX_BYTES (1024 * 1024)
+#define DROP_READ_TIMEOUT 3000
+
+/* The event thread owns drag_offer until drop. Afterwards the transfer thread
+ * owns it. No application or COM code ever runs on either of those threads. */
+static struct wayland_data_offer *drag_offer;
+static HWND drag_hwnd;
+static POINT drag_point;
+static uint32_t drag_serial;
+static pthread_mutex_t drop_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t drop_cond = PTHREAD_COND_INITIALIZER;
+static struct
+{
+    struct wayland_data_offer *offer;
+    int fd;
+    HWND hwnd;
+    POINT point;
+    ULONG_PTR generation;
+    void *data;
+    size_t size;
+    BOOL ready, handled;
+    DWORD effect;
+} pending_drop;
+static ULONG_PTR drop_generation;
+/* user32 owns a single process-wide drag object. A timed-out protocol offer
+ * must not allow another drop while application code is still handling it. */
+static BOOL drop_gui_busy;
+
+static void *read_drop_data(int fd, size_t *size)
+{
+    struct timespec now, start;
+    struct pollfd pollfd = {.fd = fd, .events = POLLIN};
+    char *data;
+    ssize_t count;
+    int remaining, ret;
+    size_t used = 0;
+
+    if (!(data = malloc(DROP_MAX_BYTES))) return NULL;
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    for (;;)
+    {
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        remaining = DROP_READ_TIMEOUT - (now.tv_sec - start.tv_sec) * 1000 -
+                    (now.tv_nsec - start.tv_nsec) / 1000000;
+        if (remaining <= 0) break;
+        ret = poll(&pollfd, 1, remaining);
+        if (ret < 0 && errno == EINTR) continue;
+        if (ret <= 0) break;
+        count = read(fd, data + used, DROP_MAX_BYTES - used);
+        if (!count) { *size = used; return data; }
+        if (count < 0)
+        {
+            if (errno == EINTR || errno == EAGAIN) continue;
+            break;
+        }
+        used += count;
+        if (used == DROP_MAX_BYTES) break;
+    }
+    WARN("file drop transfer failed, timed out, or exceeded size limit\n");
+    free(data);
+    return NULL;
+}
+
+NTSTATUS wayland_read_drop_files(void *arg)
+{
+    struct wayland_data_offer *offer;
+    struct timespec deadline;
+    void *data, *drop;
+    size_t size, drop_size;
+    DWORD effect;
+
+    pthread_mutex_lock(&drop_mutex);
+    for (;;)
+    {
+        while (!pending_drop.offer) pthread_cond_wait(&drop_cond, &drop_mutex);
+        offer = pending_drop.offer;
+        pthread_mutex_unlock(&drop_mutex);
+        drop = NULL;
+        if ((data = read_drop_data(pending_drop.fd, &size)))
+        {
+            drop = import_uri_list(data, size, &drop_size);
+            free(data);
+        }
+        close(pending_drop.fd);
+        pthread_mutex_lock(&drop_mutex);
+        pending_drop.data = drop;
+        pending_drop.size = drop ? drop_size : 0;
+        pending_drop.ready = !!drop;
+        if (drop && NtUserPostMessage(pending_drop.hwnd, WM_WAYLAND_DROP_FILES,
+                                      pending_drop.generation, 0))
+        {
+            /* A destroyed or unresponsive window must not retain offers forever.
+             * The receiver copies the payload before calling into the app. */
+            clock_gettime(CLOCK_REALTIME, &deadline);
+            deadline.tv_sec += 5;
+            while (!pending_drop.handled)
+                if (pthread_cond_timedwait(&drop_cond, &drop_mutex, &deadline) == ETIMEDOUT) break;
+        }
+        effect = pending_drop.handled ? pending_drop.effect : DROPEFFECT_NONE;
+        free(pending_drop.data);
+        memset(&pending_drop, 0, sizeof(pending_drop));
+        pthread_mutex_unlock(&drop_mutex);
+        if (effect == DROPEFFECT_COPY && wl_data_offer_get_version(offer->wl_data_offer) >= 3)
+            wl_data_offer_finish(offer->wl_data_offer);
+        wayland_data_offer_destroy(offer);
+        wl_display_flush(process_wayland.wl_display);
+        pthread_mutex_lock(&drop_mutex);
+    }
+    return 0;
+}
+
+LRESULT wayland_drop_files(HWND hwnd, ULONG_PTR generation)
+{
+    struct format_entry *entry = NULL;
+    POINT point;
+    DWORD effect = DROPEFFECT_NONE;
+    size_t size = 0;
+    BOOL claimed = FALSE;
+
+    pthread_mutex_lock(&drop_mutex);
+    if (pending_drop.ready && !pending_drop.handled && pending_drop.hwnd == hwnd &&
+        pending_drop.generation == generation)
+    {
+        claimed = TRUE;
+        size = offsetof(struct format_entry, data) + pending_drop.size;
+        if ((entry = malloc(size)))
+        {
+            entry->format = CF_HDROP;
+            entry->size = pending_drop.size;
+            memcpy(entry->data, pending_drop.data, pending_drop.size);
+            point = pending_drop.point;
+            drop_gui_busy = TRUE;
+        }
+        pending_drop.ready = FALSE;
+    }
+    pthread_mutex_unlock(&drop_mutex);
+    if (entry)
+    {
+        if (NtUserMessageCall(0, WINE_DRAG_DROP_ENTER, size, (LPARAM)entry, NULL,
+                              NtUserDragDropCall, FALSE)) goto done;
+        NtUserMessageCall(hwnd, WINE_DRAG_DROP_DRAG, MAKELONG(point.x, point.y), DROPEFFECT_COPY,
+                          NULL, NtUserDragDropCall, FALSE);
+        /* The first call enters the target; the second runs DragOver and saves
+         * its negotiated effect in user32, even when no pointer motion occurred. */
+        effect = NtUserMessageCall(hwnd, WINE_DRAG_DROP_DRAG, MAKELONG(point.x, point.y), DROPEFFECT_COPY,
+                                   NULL, NtUserDragDropCall, FALSE);
+        if (effect == DROPEFFECT_COPY)
+            effect = NtUserMessageCall(hwnd, WINE_DRAG_DROP_DROP, 0, 0, NULL, NtUserDragDropCall, FALSE);
+        else
+            NtUserMessageCall(0, WINE_DRAG_DROP_LEAVE, 0, 0, NULL, NtUserDragDropCall, FALSE);
+    }
+done:
+    free(entry);
+    pthread_mutex_lock(&drop_mutex);
+    if (entry) drop_gui_busy = FALSE;
+    if (claimed && pending_drop.generation == generation && pending_drop.hwnd == hwnd)
+    {
+        pending_drop.effect = effect;
+        pending_drop.handled = TRUE;
+        pthread_cond_signal(&drop_cond);
+    }
+    pthread_mutex_unlock(&drop_mutex);
+    return 0;
+}
+
+static BOOL drag_update_point(wl_fixed_t x, wl_fixed_t y)
+{
+    struct wayland_win_data *win_data;
+    struct wayland_surface *surface;
+    POINT point = {wl_fixed_to_double(x), wl_fixed_to_double(y)};
+
+    if (!(win_data = wayland_win_data_get(drag_hwnd))) return FALSE;
+    if ((surface = win_data->wayland_surface))
+    {
+        point = map_point_from_surface(surface, point);
+        point.x += surface->window.rect.left;
+        point.y += surface->window.rect.top;
+        drag_point = point;
+    }
+    wayland_win_data_release(win_data);
+    return !!surface;
+}
+
