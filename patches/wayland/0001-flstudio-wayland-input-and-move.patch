+/* FL's borderless plugin wrapper moves with SetWindowPos instead of SC_MOVE.
+ * Only translate a position-only change during an actual left-button gesture.
+ * The existing SysCommand path handles conventional non-client drags. */
+static BOOL wayland_flstudio_move(struct wayland_win_data *data, UINT flags,
+                                  const struct window_rects *rects)
+{
+    static const WCHAR plugin_class[] = {'T','P','l','u','g','i','n','F','o','r','m',0};
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    struct wayland_surface *surface = data->wayland_surface;
+    WCHAR buffer[64];
+    UNICODE_STRING name = {0, sizeof(buffer), buffer};
+    uint32_t serial = 0;
+
+    if (!flstudio_compat || (flags & (SWP_NOMOVE | SWP_HIDEWINDOW | SWP_SHOWWINDOW)) ||
+        !surface || !wayland_surface_is_toplevel(surface) ||
+        rects->window.right - rects->window.left != data->rects.window.right - data->rects.window.left ||
+        rects->window.bottom - rects->window.top != data->rects.window.bottom - data->rects.window.top ||
+        (rects->window.left == data->rects.window.left &&
+         rects->window.top == data->rects.window.top)) return FALSE;
+
+    if (NtUserGetClassName(data->hwnd, FALSE, &name) != ARRAY_SIZE(plugin_class) - 1 ||
+        memcmp(buffer, plugin_class, sizeof(plugin_class) - sizeof(WCHAR))) return FALSE;
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (pointer->focused_hwnd == data->hwnd && pointer->left_button_serial &&
+        pointer->custom_move_serial != pointer->left_button_serial)
+        serial = pointer->left_button_serial;
+    if (serial)
+    {
+        pthread_mutex_lock(&process_wayland.seat.mutex);
+        if (process_wayland.seat.wl_seat)
+        {
+            pointer->custom_move_serial = serial;
+            xdg_toplevel_move(surface->xdg_toplevel, process_wayland.seat.wl_seat, serial);
+        }
+        else serial = 0;
+        pthread_mutex_unlock(&process_wayland.seat.mutex);
+    }
+    pthread_mutex_unlock(&pointer->mutex);
+    if (serial) wl_display_flush(process_wayland.wl_display);
+    return !!serial;
+}
+
 /***********************************************************************
  *           WAYLAND_WindowPosChanging
  */
 BOOL WAYLAND_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped, const struct window_rects *rects)
 {
     struct wayland_win_data *data = wayland_win_data_get(hwnd);
+    BOOL moved;
 
     TRACE("hwnd %p, swp_flags %04x, shaped %u, rects %s\n", hwnd, swp_flags, shaped, debugstr_window_rects(rects));
 
     if (!data && !(data = wayland_win_data_create(hwnd, rects))) return FALSE;
 
+    moved = wayland_flstudio_move(data, swp_flags, rects);
     wayland_win_data_release(data);
+    if (moved)
+    {
+        /* End FL's drag as we hand the physical gesture to the compositor.
+         * A compositor move need not return pointer focus to this surface. */
+        INPUT input = { .type = INPUT_MOUSE, .mi.dwFlags = MOUSEEVENTF_LEFTUP };
+        NtUserSendHardwareInput(hwnd, wayland_pointer_flags, &input, 0);
+    }
 
     return TRUE;
 }
