@@ -3401,6 +3419,30 @@ static void test_msg_control(void)
     ok(ret, "CryptMsgControl failed: %08lx\n", GetLastError());
     CryptMsgClose(msg);
 
+    msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, CMSG_SIGNED, 0, NULL, NULL);
+    ret = CryptMsgUpdate(msg, signedWithUnsortedAuthAttrsBareContent,
+     sizeof(signedWithUnsortedAuthAttrsBareContent), TRUE);
+    ok(ret, "CryptMsgUpdate failed: %08lx\n", GetLastError());
+    ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &certInfo);
+    ok(ret, "CryptMsgControl failed for unsorted authenticated attributes: %08lx\n",
+     GetLastError());
+    CryptMsgClose(msg);
+
+    {
+        BYTE tampered[sizeof(signedWithUnsortedAuthAttrsBareContent)];
+
+        memcpy(tampered, signedWithUnsortedAuthAttrsBareContent, sizeof(tampered));
+        tampered[sizeof(tampered) - 1] ^= 1;
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, CMSG_SIGNED, 0, NULL, NULL);
+        ret = CryptMsgUpdate(msg, tampered, sizeof(tampered), TRUE);
+        ok(ret, "CryptMsgUpdate failed: %08lx\n", GetLastError());
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &certInfo);
+        ok(!ret && GetLastError() == NTE_BAD_SIGNATURE,
+         "Expected NTE_BAD_SIGNATURE, got ret %d, error %08lx\n", ret, GetLastError());
+        CryptMsgClose(msg);
+    }
+
     /* Test verifying signature of a detached signed message */
     msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, CMSG_DETACHED_FLAG, 0, 0,
      NULL, NULL);
